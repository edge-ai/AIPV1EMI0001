name: "AIPV1EMI0001_Yolo_Detector"
platform: "tensorrt_plan"
max_batch_size: 8
dynamic_batching { }
default_model_filename: "yolo26-fp16-1x8x8.engine"
input [
  {
    name: "images"
    data_type: TYPE_FP32
    dims: [ 3, 640, 640 ]
  }
]
output [
  {
    name: "output0"
    data_type: TYPE_FP32
    dims: [ 300, 6 ]
    label_filename: "labels-rev3.txt"
  }
]
instance_group [
  {
    kind: KIND_GPU
    count: 1
    gpus: 0
  }
]